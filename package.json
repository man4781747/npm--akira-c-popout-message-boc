{
  "name": "akira-c-popout-message-box",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "akira-c"
  ],
  "scripts": {
    "dev:local": "set USE_BUILT_MODULE=false&& vite --config vite.demo.config.js",
    "build:lib": "vite build --config vite.lib.config.js --mode es && vite build --config vite.lib.config.js --mode umd-core && vite build --config vite.lib.config.js --mode umd-vue",
    "build:demo": "vite build --config vite.demo.config.js",
    "dev:built": "set USE_BUILT_MODULE=true&& npm run build:lib && vite --config vite.demo.config.js",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "files": [
    "lib"
  ],
  "main": "lib/popout-message-box.umd.cjs",
  "module": "lib/popout-message-box.js",
  "types": "lib/packages/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/packages/index.d.ts",
      "import": "./lib/popout-message-box.js",
      "require": "./lib/popout-message-box.umd.cjs"
    },
    "./core": {
      "types": "./lib/packages/core.d.ts",
      "import": "./lib/popout-message-box-core.js",
      "require": "./lib/popout-message-box-core.umd.cjs"
    },
    "./lib/popout-message-box.css": {
      "import": "./lib/popout-message-box.css",
      "require": "./lib/popout-message-box.css"
    }
  },
  "peerDependencies": {
    "vue": "^3.2.41"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "postcss-nesting": "^10.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^5.0.5",
    "vue": "^3.2.41",
    "vue-tsc": "^3.3.13"
  }
}
